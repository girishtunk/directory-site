---
import BaseLayout from "../layouts/BaseLayout.astro";

import "../styles/global.css";

---

<BaseLayout
  title="Contact Us | Submit Property | Surya Property Consultant"
  description="Submit your property or contact Surya Property Consultant for buying, selling, leasing, and investment opportunities."
>
  <div class="container contact-page">
    <h1>Contact Us / Submit Your Property</h1>

    <p>
      Looking to <strong>sell, lease, or invest</strong> in property?
      Share your details and our team will get in touch with you shortly.
    </p>

    <form class="contact-form" id="propertyForm">
      <h2>Owner / Client Details</h2>

      <div class="form-group">
        <label for="name">Full Name *</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="form-group">
        <label for="phone">Phone Number *</label>
        <input type="tel" id="phone" name="phone" required />
      </div>

      <div class="form-group">
        <label for="email">Email (Optional)</label>
        <input type="email" id="email" name="email" />
      </div>

      <h2>Property Details</h2>

      <div class="form-group">
        <label for="property_type">Property Type *</label>
        <select id="property_type" name="property_type" required>
          <option value="">Select Property Type</option>
          <option value="apartment">Apartment / Flat</option>
          <option value="villa">Villa / Independent House</option>
          <option value="commercial">Commercial Property</option>
          <option value="plot">Open Plot / Land</option>
        </select>
      </div>

      <div class="form-group">
        <label for="listing_type">Purpose *</label>
        <select id="listing_type" name="listing_type" required>
          <option value="">Select Purpose</option>
          <option value="sale">Sale</option>
          <option value="rent">Rent / Lease</option>
          <option value="investment">Investment</option>
        </select>
      </div>

      <div class="form-group">
        <label for="location">Property Location *</label>
        <input
          type="text"
          id="location"
          name="location"
          placeholder="Area / Locality / City"
          required
        />
      </div>

      <div class="form-group">
        <label for="budget">Expected Price / Rent</label>
        <input
          type="text"
          id="budget"
          name="budget"
          placeholder="e.g. ₹2.5 Cr / ₹80,000 per month"
        />
      </div>

      <div class="form-group">
        <label for="message">Additional Details</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Tenant details, size, floor, facing, rental income, etc."
        ></textarea>
      </div>

      <button type="submit" class="btn btn-primary">
        Submit Property Details
      </button>
    </form>
  </div>
</BaseLayout>

<script type="module" src="/scripts/contact.js"></script>