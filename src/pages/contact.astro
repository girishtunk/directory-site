---
import { base } from "astro:config/client";

import BaseLayout from "../layouts/BaseLayout.astro";

---
<BaseLayout
  title="Contact Us | Buy or Sell Property | Surya Property Consultant"
  description="Contact Surya Property Consultant for buying, selling, renting, leasing, and property investment support in Hyderabad."
>
  <div class="container contact-page">
    <p class="section-eyebrow">Private Consultation</p>
    <h1>Let’s discuss your next move.</h1>

    <p class="contact-intro">
      Whether you are a <strong>buyer looking for the right property</strong> or a
      <strong>seller planning to list your asset</strong>, share your details and our
      team will get in touch shortly.
    </p>

    <div class="contact-audience-cards">
      <article class="audience-card">
        <h2>For Buyers</h2>
        <p>Share your budget, preferred location, and property type.</p>
      </article>
      <article class="audience-card">
        <h2>For Sellers</h2>
        <p>Share your property details, expected price, and listing purpose.</p>
      </article>
    </div>

    <form class="contact-form" id="propertyForm">
      <input type="hidden" id="property_id" name="property_id" />
      <input type="hidden" id="property_title" name="property_title" />
      <input type="hidden" id="source_url" name="source_url" />

      <aside class="enquiry-property-context" id="enquiry-property-context" hidden>
        <span>Enquiring about</span>
        <strong id="enquiry-property-title"></strong>
        <small id="enquiry-property-meta"></small>
      </aside>

      <h2>Enquiry Type</h2>

      <div class="form-group">
        <label for="client_type">I am a *</label>
        <select id="client_type" name="client_type" required>
          <option value="">Select One</option>
          <option value="buyer">Buyer</option>
          <option value="seller">Seller</option>
          <option value="buyer_and_seller">Buyer and Seller</option>
          <option value="investor">Investor</option>
        </select>
      </div>

      <h2>Contact Details</h2>

      <div class="form-group">
        <label for="name">Full Name *</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="form-group">
        <label for="phone">Phone Number *</label>
        <input type="tel" id="phone" name="phone" required />
      </div>

      <div class="form-group">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" required />
      </div>

      <h2>Requirement / Property Details</h2>

      <div class="form-group">
        <label for="property_type">Property Type *</label>
        <select id="property_type" name="property_type" required>
          <option value="">Select Property Type</option>
          <option value="apartment">Apartment / Flat</option>
          <option value="villa">Villa / Independent House</option>
          <option value="commercial">Commercial Property</option>
          <option value="plot">Open Plot / Land</option>
        </select>
      </div>

      <div class="form-group">
        <label for="listing_type">Requirement Type *</label>
        <select id="listing_type" name="listing_type" required>
          <option value="">Select Requirement</option>
          <option value="buy">Buy Property</option>
          <option value="rent">Rent / Lease Property</option>
          <option value="sell">Sell Property</option>
          <option value="lease_out">Lease Out Property</option>
          <option value="investment">Investment</option>
        </select>
      </div>

      <div class="form-group">
        <label for="location">Preferred / Property Location *</label>
        <input
          type="text"
          id="location"
          name="location"
          placeholder="Area / Locality / City"
          required
        />
      </div>

      <div class="form-group">
        <label for="budget">Budget / Expected Price</label>
        <input
          type="text"
          id="budget"
          name="budget"
          placeholder="e.g. Budget ₹2.5 Cr or Expected ₹80,000 per month"
        />
      </div>

      <div class="form-group">
        <label for="message">Additional Details</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="For buyers: BHK, amenities, possession timeline. For sellers: size, facing, floor, rental income, etc."
        ></textarea>
      </div>

      <button type="submit" class="btn btn-primary">
        Submit Enquiry
      </button>
    </form>
  </div>
</BaseLayout>

<script type="module" src={base + "scripts/contact.js"}></script>
