---
import { base } from "astro:config/client";
import { getProperties } from "../lib/properties";
import PropertyCard from "../components/PropertyCard.astro";
import SearchFilter from "../components/SearchFilter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogPosts } from "../lib/blogPosts";

const properties = await getProperties();
const propertyCards = properties;
const propertyAreas = propertyCards.map((property) => property.area).filter(Boolean);
const totalAreas = new Set(propertyAreas).size;
const featuredCount = propertyCards.filter((property) => property.featured).length;
const investorCount = propertyCards.filter((property) => property.is_rental_income).length;
---

<BaseLayout
  title="Property Listings in Hyderabad"
  description="Buy apartments, villas, and commercial properties in Hyderabad"
>
  <section class="container listing-page">
    <section class="listing-hero">
      <div class="listing-hero-copy">
        <p class="section-eyebrow">Hyderabad Property Advisory</p>
        <h1>Considered spaces.<br /><em>Confident decisions.</em></h1>
        <p class="section-intro hero-intro">
          A selective collection of homes, land, and commercial opportunities, backed by local
          knowledge and straightforward advice.
        </p>
        <div class="hero-actions">
          <a href="#property-grid" class="btn">Explore properties</a>
          <a href={base + "contact"} class="hero-text-link">Speak with an advisor <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="listing-hero-stats">
        <article class="stat-card">
          <strong>{properties.length}</strong>
          <span>Active Listings</span>
        </article>
        <article class="stat-card">
          <strong>{totalAreas}</strong>
          <span>High-Demand Areas</span>
        </article>
        <article class="stat-card">
          <strong>{featuredCount}</strong>
          <span>Featured opportunities</span>
        </article>
        <article class="stat-card">
          <strong>{investorCount}</strong>
          <span>Income assets</span>
        </article>
      </div>
    </section>

    <SearchFilter properties={propertyCards} />

    <section class="results-section">
      <div class="section-heading results-heading">
        <div>
          <p class="section-eyebrow">Current Collection</p>
          <h2>Properties worth considering</h2>
        </div>
      </div>
      <div class="results-shell">
        <div class="grid premium-grid" id="property-grid">
          {propertyCards.map((property) => (
            <PropertyCard property={property} />
          ))}
        </div>

        <div id="empty-state" class="empty-state premium-empty-state" hidden>
          <h2>No properties match these filters</h2>
          <p>
            Try widening the budget, changing area, or switching from hot deals to all listings.
          </p>
          <button type="button" class="btn" id="empty-reset-filters">Show All Properties</button>
        </div>

        <div class="pagination" id="pagination"></div>
      </div>
    </section>

    <section class="content-section blog-section">
      <div class="section-heading">
        <div>
          <p class="section-eyebrow">Blog Posts</p>
          <h2>Property Insights for Buyers and Investors</h2>
        </div>
        <a href={base + "blog"}>View all posts</a>
      </div>

      <div class="blog-grid">
        {blogPosts.map((post) => (
          <article class="blog-card">
            <p class="blog-card-meta">{post.category} <span>·</span> {post.readTime}</p>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <div class="blog-card-footer">
              <span>{post.publishedOn}</span>
              <a href={`${base}blog/${post.slug}`}>Read article →</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
<link rel="stylesheet" href={base + "styles/global.css"}>
<script type="module" src={base + "scripts/homepage.js"}></script>
