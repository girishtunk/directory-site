---
import { base } from "astro:config/client";
import { getProperties } from "../../lib/properties";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const properties = await getProperties();
    console.log('properties: ${p}')

  return properties.map((p) => ({
    params: { slug: p.slug },
    props: { property: p },
  }));
}

const { property } = Astro.props;

const DEFAULT_IMAGES = {
  apartment: base + "images/defaults/apartment.jpg",
  villa: base + "images/defaults/villa.jpg",
  commercial: base + "images/defaults/commercial.jpg",
  "independent-house": base + "images/defaults/house.jpg",
};

// Final image selection
const imageSrc =
  property.image ||
  DEFAULT_IMAGES[property.property_type]
---

<html lang="en">
  <head>
    <script type="application/ld+json">
    {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "RealEstateListing",
    "name": property.title,
    "description": property.short_description,
    "image": property.cover_image,
    "url": `https://yourdomain.com/property/${property.slug}`,
    "address": {
        "@type": "PostalAddress",
        "addressLocality": property.area,
        "addressRegion": property.city,
        "addressCountry": "IN"
    },
    "offers": {
        "@type": "Offer",
        "price": property.total_price_cr,
        "priceCurrency": "INR"
    }
    })}
    </script>
    <title>{property.seo_title || property.title}</title>
    <meta
      name="description"
      content={property.seo_description || property.short_description}
    />

    <!-- SEO basics -->
    <meta name="keywords" content={property.keywords} />
    <link rel="canonical" href={`https://yourdomain.com/property/${property.slug}`} />

    <!-- OpenGraph -->
    <meta property="og:title" content={property.title} />
    <meta property="og:description" content={property.short_description} />
    <meta property="og:image" content={property.cover_image} />
    <meta property="og:type" content="website" />
  </head>

  <body>
      <BaseLayout
        title="Property Listings in Hyderabad"
        description="Buy apartments, villas, and commercial properties in Hyderabad"
      >
    <main class="property-page container">
  <h1> {property.title}</h1>

  <div class="property-top">
    <div class="property-images">
      <img src={imageSrc} alt={property.title} />
      <!-- optional gallery -->
      {property.gallery_images?.split(",").map(img => (
        <img src={img} alt={property.title} class="gallery-img" />
      ))}
    </div>

    <div class="property-info">
    {property.featured && <span class="badge-featured">Featured</span>}

      <p class="price"> &#8377; {property.total_price_cr} Cr</p>
      {property.is_rental_income && (
        <p>Monthly Rent: &#8377; {property.monthly_rent_lakhs} Lakh</p>
      )}
      
      <ul class="details">
        <li><strong>Property ID:</strong> {property.id}</li>
        <li><strong>Facing:</strong> {property.facing}</li>
        <li><strong>Floor:</strong> {property.floor}/{property.total_floors}</li>
        <li><strong>Built-up Area:</strong> {property.built_up_area_sft} SFT</li>
        {property.bhk && <li><strong>BHK:</strong> {property.bhk}</li>}
        {property.parking_slots && <li><strong>Parking:</strong> {property.parking_slots}</li>}
      </ul>

      <div class="cta-buttons">
        <a href="tel:{property.phone}" class="btn">Call Agent</a>
        <a href={property.brochure_link} class="btn" target="_blank">Download Brochure</a>
      </div>
    </div>
  </div>

  <section class="property-description">
  {property.google_maps_link && (
        <iframe
            src={property.google_maps_link}
            width="100%"
            height="300"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
        ></iframe>
        )}
    <h2>Description</h2>
    <p>{property.full_description}</p>
  </section>
</main>
</BaseLayout>
  </body>
</html>
