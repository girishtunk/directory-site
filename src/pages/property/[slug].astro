---
import { base } from "astro:config/client";
import { getProperties } from "../../lib/properties";
import { formatLocationParts } from "../../lib/location";
import BaseLayout from "../../layouts/BaseLayout.astro";

type Property = Awaited<ReturnType<typeof getProperties>>[number];

export async function getStaticPaths() {
  const properties = await getProperties();

  return properties.map((property: Property) => ({
    params: { slug: property.slug },
    props: { property },
  }));
}

const { property } = Astro.props as { property: Property };

const DEFAULT_IMAGES = {
  apartment: base + "images/defaults/apartment.jpg",
  villa: base + "images/defaults/villa.jpg",
  commercial: base + "images/defaults/commercial.jpg",
  "independent-house": base + "images/defaults/house.jpg",
};

const FALLBACK_TEXT = "Available on request";

const galleryImages = property.gallery_images
  ?.split(",")
  .map((img: string) => img.trim())
  .filter(Boolean) || [];

const imageSrc =
  property.cover_image ||
  DEFAULT_IMAGES[property.property_type as keyof typeof DEFAULT_IMAGES] ||
  DEFAULT_IMAGES["independent-house"];

const pageTitle = property.seo_title || property.title;
const pageDescription = property.seo_description || property.short_description || property.full_description;

const priceLabel = property.total_price_cr != null ? `\u20B9 ${property.total_price_cr} Cr` : FALLBACK_TEXT;
const rentLabel = property.is_rental_income && property.monthly_rent_lakhs
  ? `\u20B9 ${property.monthly_rent_lakhs} Lakh / month`
  : FALLBACK_TEXT;

const locationLabel = formatLocationParts(property.locality, property.area, property.city) || FALLBACK_TEXT;
const sizeLabel = property.built_up_area_sft
  ? `${property.built_up_area_sft} SFT`
  : property.plot_area_sqyd
    ? `${property.plot_area_sqyd} Sq.yd`
    : FALLBACK_TEXT;

const summaryItems = [
  { label: "Price", value: priceLabel },
  { label: "Location", value: locationLabel },
  { label: "Property Type", value: property.property_type || FALLBACK_TEXT },
  { label: "Listing Type", value: property.listing_type || FALLBACK_TEXT },
  { label: "Status", value: property.status || FALLBACK_TEXT },
  { label: "Built-up / Plot Size", value: sizeLabel },
];

const specificationItems = [
  { label: "Property ID", value: property.id || FALLBACK_TEXT },
  { label: "Facing", value: property.facing || FALLBACK_TEXT },
  {
    label: "Floor",
    value:
      property.floor && property.total_floors
        ? `${property.floor} / ${property.total_floors}`
        : property.floor || property.total_floors || FALLBACK_TEXT,
  },
  { label: "BHK", value: property.bhk || FALLBACK_TEXT },
  { label: "Bathrooms", value: property.bathrooms || FALLBACK_TEXT },
  { label: "Parking", value: property.parking_slots || FALLBACK_TEXT },
  { label: "View", value: property.view || FALLBACK_TEXT },
  { label: "Unit Number", value: property.unit_number || FALLBACK_TEXT },
  { label: "Tower / Block", value: property.block_tower || FALLBACK_TEXT },
  { label: "Address", value: property.address || FALLBACK_TEXT },
];

const projectItems = [
  { label: "Project Name", value: property.project_name || FALLBACK_TEXT },
  { label: "Developer", value: property.developer || FALLBACK_TEXT },
  { label: "Possession", value: property.possession_status || FALLBACK_TEXT },
  { label: "RERA Number", value: property.rera_number || FALLBACK_TEXT },
  { label: "Amenities", value: property.amenities || FALLBACK_TEXT },
];

const investmentItems = [
  { label: "Monthly Rent", value: rentLabel },
  { label: "Annual Yield", value: property.annual_yield_percent ? `${property.annual_yield_percent}%` : FALLBACK_TEXT },
  { label: "Tenant Type", value: property.tenant_type || FALLBACK_TEXT },
  { label: "Lease Period", value: property.lease_period_years ? `${property.lease_period_years} years` : FALLBACK_TEXT },
  { label: "Lock-in", value: property.lock_in_years ? `${property.lock_in_years} years` : FALLBACK_TEXT },
  { label: "Rent Hike", value: property.rent_hike_percent ? `${property.rent_hike_percent}%` : FALLBACK_TEXT },
];

const contactItems = [
  { label: "Agent", value: property.agent_name || FALLBACK_TEXT },
  { label: "Company", value: property.company || FALLBACK_TEXT },
  { label: "Phone", value: property.phone || FALLBACK_TEXT },
];

function getValue(value: string) {
  return value || FALLBACK_TEXT;
}
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="property-page-shell container">
    <div class="property-breadcrumbs">
      <a href={base}>Home</a>
      <span>/</span>
      <a href={base}>Properties</a>
      <span>/</span>
      <span>{property.title}</span>
    </div>

    <section class="property-hero">
      <div class="property-hero-copy">
        <div class="property-badges-row">
          {property.featured && <span class="property-chip property-chip-primary">Featured</span>}
          {property.is_rental_income && <span class="property-chip property-chip-success">Rental Income</span>}
          <span class="property-chip">{getValue(property.status)}</span>
        </div>

        <h1>{property.title}</h1>
        <p class="property-hero-location">{locationLabel}</p>
        <p class="property-hero-description">{getValue(property.short_description || property.full_description)}</p>

        <div class="property-hero-actions">
          {property.phone && <a href={`tel:${property.phone}`} class="btn">Call Now</a>}
          <a href={base + "contact"} class="btn btn-secondary">Schedule Visit</a>
        </div>
      </div>

      <aside class="property-summary-card">
        <div class="property-summary-price">Price: {priceLabel}</div>
        <div class="property-summary-grid">
          {summaryItems.map((item) => (
            <div class="property-summary-item">
              <span>{item.label}</span>
              <strong title={item.value}>{item.value}</strong>
            </div>
          ))}
        </div>
      </aside>
    </section>

    <section class="property-layout">
      <div class="property-main-column">
        <section class="property-gallery-card">
          <img src={imageSrc} alt={property.title} class="property-main-image" />
          {galleryImages.length > 0 && (
            <div class="property-gallery-grid">
              {galleryImages.map((img: string) => (
                <img src={img} alt={property.title} class="property-gallery-thumb" />
              ))}
            </div>
          )}
        </section>

        <section class="property-section-card">
          <div class="property-section-heading">
            <h2>Overview</h2>
            <p>Key information organised for faster shortlisting.</p>
          </div>
          <div class="property-detail-grid">
            {specificationItems.map((item) => (
              <div class="property-detail-item">
                <span>{item.label}</span>
                <strong title={item.value}>{item.value}</strong>
              </div>
            ))}
          </div>
        </section>

        <section class="property-section-card">
          <div class="property-section-heading">
            <h2>Description</h2>
            <p>Listing narrative and buyer-facing summary.</p>
          </div>
          <div class="property-description-copy">
            <p>{getValue(property.full_description || property.short_description)}</p>
          </div>
        </section>

        <section class="property-section-card">
          <div class="property-section-heading">
            <h2>Project Details</h2>
            <p>Development, compliance, and project-level context.</p>
          </div>
          <div class="property-detail-grid">
            {projectItems.map((item) => (
              <div class="property-detail-item">
                <span>{item.label}</span>
                <strong title={item.value}>{item.value}</strong>
              </div>
            ))}
          </div>
        </section>

        <section class="property-section-card">
          <div class="property-section-heading">
            <h2>Investment Snapshot</h2>
            <p>Income-related information, where available.</p>
          </div>
          <div class="property-detail-grid">
            {investmentItems.map((item) => (
              <div class="property-detail-item">
                <span>{item.label}</span>
                <strong title={item.value}>{item.value}</strong>
              </div>
            ))}
          </div>
        </section>

        <section class="property-section-card">
          <div class="property-section-heading">
            <h2>Location Map</h2>
            <p>Site context and approach reference.</p>
          </div>
          {property.google_maps_link ? (
            <div class="property-map-frame">
              <iframe
                src={property.google_maps_link}
                width="100%"
                height="360"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
              ></iframe>
            </div>
          ) : (
            <p class="property-empty-state">Available on request</p>
          )}
        </section>
      </div>

      <aside class="property-sidebar">
        <section class="property-section-card property-contact-card">
          <div class="property-section-heading">
            <h2>Contact</h2>
            <p>Reach out for site visit, price confirmation, and availability.</p>
          </div>
          <div class="property-detail-stack">
            {contactItems.map((item) => (
              <div class="property-detail-item">
                <span>{item.label}</span>
                <strong title={item.value}>{item.value}</strong>
              </div>
            ))}
          </div>

          <div class="property-sidebar-actions">
            {property.phone && <a href={`tel:${property.phone}`} class="btn">Call {property.agent_name || "Agent"}</a>}
            <a href={base + "contact"} class="btn btn-secondary">Send Enquiry</a>
          </div>
        </section>
      </aside>
    </section>
  </section>
</BaseLayout>
