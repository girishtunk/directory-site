---
import { base } from "astro:config/client";

import BaseLayout from "../layouts/BaseLayout.astro";
---
    <link rel="stylesheet" href={base + "styles/global.css"} />

<BaseLayout
  title="About Us | Surya Property Consultant"
  description="Surya Property Consultant offers trusted residential, commercial, and investment-focused real estate services with legal clarity and high ROI opportunities."
>
  <div class="container about-page">
    <h1>About Surya Property Consultant</h1>

    <p>
      At <strong>Surya Property Consultant</strong>, we believe real estate is not just about property —
      it’s about <strong>long-term value, trust, and informed decision-making</strong>.
    </p>

    <p>
      With in-depth market knowledge and a strong network of investors, developers, and property owners,
      we deliver <strong>customized real estate solutions</strong> for individuals and businesses alike.
    </p>

    <ul>
      <li>Home Buyers & Sellers</li>
      <li>Business Owners</li>
      <li>Real Estate Investors</li>
      <li>Land Owners</li>
    </ul>

    <p>
      Our focus is on <strong>transparency, legal clarity, and maximizing returns</strong> for our clients.
    </p>

    <hr />

    <h2>Our Services</h2>

    <h3>Residential Properties</h3>
    <ul>
      <li>Apartments & Flats – Purchase and Sale</li>
      <li>Residential Rentals</li>
      <li>Villas & Gated Community Homes</li>
    </ul>

    <h3>Commercial Properties</h3>
    <ul>
      <li>Commercial Spaces – Purchase & Sale</li>
      <li>Office Spaces & Retail Units – Leasing</li>
      <li>Pre-Tenanted Commercial Properties</li>
    </ul>

    <h3>Open Plots & Land</h3>
    <ul>
      <li>Residential Open Plots</li>
      <li>Commercial Plots</li>
      <li>Investment-Grade Land Parcels</li>
    </ul>

    <hr />

    <h2>Investor Services</h2>
    <ul>
      <li>High ROI Property Identification</li>
      <li>Pre-Leased Assets for Stable Returns</li>
      <li>Bulk Deals & Off-Market Opportunities</li>
    </ul>

    <p>
      Whether you’re seeking steady rental income or long-term appreciation,
      we help you invest with confidence.
    </p>

    <hr />

    <h2>Property Categories</h2>
    <ul>
      <li>Residential Apartments</li>
      <li>Villas & Independent Houses</li>
      <li>Commercial Offices</li>
      <li>Retail & Showroom Spaces</li>
      <li>Pre-Tenanted Commercial Properties</li>
      <li>Open Residential & Commercial Plots</li>
    </ul>

    <hr />

    <h2>Why Choose Surya Property Consultant?</h2>
    <ul>
      <li>✔ Verified & Legally Clear Properties</li>
      <li>✔ Strong Investor & Developer Network</li>
      <li>✔ Market-Driven Pricing Guidance</li>
      <li>✔ End-to-End Transaction Support</li>
      <li>✔ Confidential & Professional Dealings</li>
    </ul>

    <p>
      We focus on <strong>quality over quantity</strong>, ensuring every property meets
      high standards of legality, location, and value.
    </p>

    <hr />

    <h2>For Property Owners</h2>
    <p>
      Looking to sell or lease your property?
    </p>
    <p>
      We connect your property with <strong>serious buyers, tenants, and investors</strong>
      using professional marketing strategies and our investor database.
    </p>

    <a href= {base + "contact"} class="btn">Submit Your Property →</a>

    <hr />

    <h2>For Investors</h2>
    <ul>
      <li>Pre-Tenanted Commercial Spaces</li>
      <li>High-Growth Land Parcels</li>
      <li>Long-Term Rental Yield Assets</li>
    </ul>

    <p>
      <strong>Let your money work smarter with real estate.</strong>
    </p>

    <hr />

    <h2>Modern Website Features</h2>
    <ul>
      <li>Advanced Property Search & Filters</li>
      <li>ROI & Rental Yield Calculator</li>
      <li>Verified Property Badge</li>
      <li>Google Map Property Location</li>
      <li>One-Click WhatsApp & Call</li>
    </ul>
  </div>
</BaseLayout>
