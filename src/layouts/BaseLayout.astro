---
import { base } from "astro:config/client";
const { title = "Real Estate Directory", description = "" } = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { href: base, label: "Properties", match: pathname === base },
  { href: base + "projects", label: "Projects", match: pathname.startsWith(base + "projects") },
  { href: base + "blog", label: "Journal", match: pathname.startsWith(base + "blog") },
  { href: base + "about", label: "About", match: pathname.startsWith(base + "about") },
  { href: base + "contact", label: "Contact", match: pathname.startsWith(base + "contact") },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17352f" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0YQCFL65JV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0YQCFL65JV');
    </script>
    <link rel="icon" type="image/jpeg" href={base + "images/logo/suryaproperties.jpeg"} />
    <link rel="apple-touch-icon" href={base + "images/logo/suryaproperties.jpeg"} />
    <link rel="stylesheet" href={base + "styles/global.css"} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={base} class="logo" aria-label="Surya Property Consultant home">
          <img
            src={base + "images/logo/suryaproperties.jpeg"}
            alt="Surya Property Consultant logo"
            class="logo-image"
          />
          <span class="logo-copy">
            <span class="logo-text">Surya Property Consultant</span>
            <span class="logo-kicker">Hyderabad · Est. 2020</span>
          </span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
        <label for="nav-toggle" class="nav-toggle-button" aria-label="Toggle navigation">
          <span></span>
          <span></span>
          <span></span>
        </label>

        <div class="header-menu">
          <nav class="main-nav" aria-label="Primary navigation">
            {navItems.map((item) => (
              <a href={item.href} class:list={{ active: item.match }} aria-current={item.match ? "page" : undefined}>{item.label}</a>
            ))}
          </nav>

          <div class="header-cta">
            <a href={base + "contact"} class="btn header-cta-button">Request a consultation</a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <strong>Surya Property Consultant</strong>
          <p>Independent property advice for Hyderabad.</p>
        </div>
        <p class="footer-meta">TG RERA NO. A02200002962<br />© {new Date().getFullYear()} All rights reserved.</p>
        <div class="social-section" aria-label="Social media links">
          <span class="social-title">Follow Us</span>
          <div class="social-links">
            <a
              href="https://www.instagram.com/suryapropertyco"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <i class="fa-brands fa-instagram" aria-hidden="true"></i>
              <span class="sr-only">Instagram</span>
            </a>
            <a
              href="https://www.facebook.com/people/Surya-Property-Consultant/61584014787759/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
              <span class="sr-only">Facebook</span>
            </a>
            <a
              href="https://www.linkedin.com/in/surya-property-consultant-anand-baradi-4820273aa/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
              <span class="sr-only">LinkedIn</span>
            </a>
            <a
              href="https://www.youtube.com/@suryapropertyconsultant"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
            >
              <i class="fa-brands fa-youtube" aria-hidden="true"></i>
              <span class="sr-only">YouTube</span>
            </a>
            <a
              href="https://whatsapp.com/channel/0029VaLGi8YEquiKU4eRbl01"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
            >
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
              <span class="sr-only">WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
