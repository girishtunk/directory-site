---
const { property } = Astro.props;

const DEFAULT_IMAGES = {
  apartment: "/images/defaults/apartment.jpg",
  villa: "/images/defaults/villa.jpg",
  commercial: "/images/defaults/commercial.jpg",
  "independent-house": "/images/defaults/house.jpg",
};

// Final image selection
const imageSrc =
  property.image ||
  DEFAULT_IMAGES[property.property_type]
---

<article
  class="card"
  data-type={property.property_type}
  data-area={property.area?.toLowerCase() || ""}
>
  <img
    src={imageSrc}
    alt={property.title}
    loading="lazy"
    onerror="this.src='images/defaults/house.jpg'"
  />

  <h2>{property.title}</h2>

  <p>
    {property.area}, {property.city}
  </p>

  <p class="price">&#8377; {property.total_price_cr} Cr</p>

  <a href={`/property/${property.slug}`} class="btn">
    View Details
  </a>
</article>
