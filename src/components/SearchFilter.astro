---
type SearchProperty = {
  area?: string;
};

const { properties = [] } = Astro.props as { properties?: SearchProperty[] };

const areaCounts = properties.reduce<Record<string, number>>((acc, property) => {
  const area = property.area;

  if (!area) {
    return acc;
  }

  acc[area] = (acc[area] || 0) + 1;
  return acc;
}, {});

const topAreas = Object.entries(areaCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([area]) => area);
---

<section class="search-panel premium-search" aria-label="Property search and filters">
  <div class="search-panel-intro">
    <div class="search-field search-panel-primary">
      <label class="sr-only" for="search-input">Search by area, locality, landmark, or title</label>
      <div class="search-input-wrap search-input-rich search-input-compact">
        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        </span>
        <input
          type="search"
          placeholder="Search by area, project, or property type"
          id="search-input"
          autocomplete="off"
          enterkeyhint="search"
          aria-describedby="search-help"
        />
        <button type="button" id="clear-search" class="clear-search" aria-label="Clear search">
          Clear
        </button>
      </div>
      <p id="search-help" class="sr-only">
        Search across locations, landmarks, and listing titles.
      </p>
      <ul id="search-suggestions" class="suggestions"></ul>
    </div>

    <div class="search-panel-actions">
      <button
        type="button"
        class="btn btn-secondary"
        id="toggle-advanced-filters"
        aria-expanded="false"
        aria-controls="advanced-filters"
      >
        Filters <span aria-hidden="true">＋</span>
      </button>
    </div>
  </div>

  <div id="advanced-filters" class="advanced-filters" hidden>
    <div class="advanced-filters-toolbar">
      <p class="advanced-filters-label">Refine your search</p>
      <button type="button" class="btn btn-secondary" id="reset-filters">
        Clear all
      </button>
    </div>

    <div class="filters filters-rich">
      <div class="filter-field">
        <label for="area-filter">Area</label>
        <select id="area-filter">
          <option value="all">All Areas</option>
          {Object.keys(areaCounts).sort().map((area) => <option value={area}>{area}</option>)}
        </select>
      </div>

      <div class="filter-field">
        <label for="type-filter">Property Type</label>
        <select id="type-filter">
          <option value="all">All Types</option>
          <option value="apartment">Apartment</option>
          <option value="villa">Villa</option>
          <option value="commercial">Commercial</option>
          <option value="residential-plot">Residential Plots</option>
          <option value="commercial-plot">Commercial Plots</option>
          <option value="independent-house">Independent House</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="price-filter">Budget</label>
        <select id="price-filter">
          <option value="all">All Budgets</option>
          <option value="under-3">Under 3 Cr</option>
          <option value="3-5">3 Cr to 5 Cr</option>
          <option value="5-10">5 Cr to 10 Cr</option>
          <option value="10-plus">10 Cr and above</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="facing-filter">Facing</label>
        <select id="facing-filter">
          <option value="all">Any Facing</option>
          <option value="east">East</option>
          <option value="west">West</option>
          <option value="north">North</option>
          <option value="south">South</option>
          <option value="north-east">North-East</option>
          <option value="north-west">North-West</option>
          <option value="south-east">South-East</option>
          <option value="south-west">South-West</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="deal-filter">Deal Profile</label>
        <select id="deal-filter">
          <option value="all">All Listings</option>
          <option value="featured">Hot Deals</option>
          <option value="investor">Investor-Focused</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="sort-filter">Sort By</label>
        <select id="sort-filter">
          <option value="recommended">Recommended</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="area-az">Area: A to Z</option>
        </select>
      </div>
    </div>

    <div class="quick-area-strip" aria-label="Popular areas">
      <span class="quick-area-label">Popular Areas</span>
      <div class="quick-area-chips">
        {topAreas.map((area) => (
          <button type="button" class="quick-area-chip" data-area-chip={area}>{area}</button>
        ))}
      </div>
    </div>
  </div>

  <div class="search-feedback premium-search-feedback">
    <p id="results-summary" class="results-summary" aria-live="polite"></p>
    <div id="active-filters" class="active-filters"></div>
  </div>
</section>
